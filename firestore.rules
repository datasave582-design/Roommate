rules_version = '2';

// ============================================================================
// THE ROOMMATE — Firestore Security Rules
// These rules ARE the authorization layer. The client never grants access by
// itself (no "localStorage.role" or "admin=true" trust) — every read/write is
// re-checked here against server-held facts: rooms/{id}.adminUid,
// properties/{id}.ownerUid, and rooms/{id}/members/{uid}.status.
//
// Phase 1 covers Room Admin + Roommate collections. Landlord/property
// collections are included so Phase 2 can attach directly without a
// rules rewrite; they currently allow only the owning landlord full access.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isRoomAdmin(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.adminUid == request.auth.uid;
    }
    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isActiveRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.status == "active";
    }
    function isRoomAdminAfter(roomId) {
      return isSignedIn()
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.adminUid == request.auth.uid;
    }
    function isLandlordForRoom(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.get("landlordUid", null) == request.auth.uid;
    }
    function isApprovedConnection(adminUid, landlordUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/landlordConnections/$(adminUid))
        && get(/databases/$(database)/documents/landlordConnections/$(adminUid)).data.status == "approved"
        && get(/databases/$(database)/documents/landlordConnections/$(adminUid)).data.landlordUid == landlordUid;
    }
    function isLandlordOwner(propertyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/properties/$(propertyId))
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid;
    }
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // ---------------------------------------------------------------------
    // users/{uid} — profile. Role is set once at registration and is
    // frontend-immutable forever after (rule below blocks any role change,
    // no matter what the client sends).
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ["roomAdmin", "landlord", "roommate"];

      // A landlord can read only their own profile. Room Admin/Roommate profiles
      // are private from the landlord.
      allow read: if isSelf(uid);

      // Two ways a user doc can be updated, both frontend-blocked from
      // touching role/uid:
      //  1. The user updates their own profile fields.
      //  2. The admin of the room named in the incoming write stamps
      //     `roomId` onto a member's profile right after approving them.
      allow update: if roleUnchanged() && request.resource.data.uid == resource.data.uid
        && (
          // A user may edit their own profile without changing role/uid or
          // changing the room/landlord relationship. This also permits the
          // landlordCode field to be stamped onto a landlord profile.
          (isSelf(uid)
            && request.resource.data.get("roomId", null) == resource.data.get("roomId", null)
            && request.resource.data.get("landlordUid", null) == resource.data.get("landlordUid", null))
          // A Room Admin may stamp/clear a room relationship when they are
          // the actual admin of that room.
          || (request.resource.data.get("roomId", null) is string
            && isRoomAdmin(request.resource.data.get("roomId", null)))
          || (request.resource.data.get("roomId", null) is string
            && isRoomAdminAfter(request.resource.data.get("roomId", null)))
          || (resource.data.get("roomId", null) is string
            && request.resource.data.get("roomId", null) == null
            && isRoomAdmin(resource.data.get("roomId", null)))
          // Atomic landlord approval stamps the Room Admin profile.
          || (isSignedIn()
            && request.resource.data.get("landlordUid", null) == request.auth.uid
            && request.resource.data.get("landlordConnectionStatus", null) == "approved"
            && getAfter(/databases/$(database)/documents/landlordConnections/$(uid)).data.status == "approved"
            && getAfter(/databases/$(database)/documents/landlordConnections/$(uid)).data.landlordUid == request.auth.uid)
        );

      allow delete: if false;

      match /notifications/{notifId} {
        allow read, update: if isSelf(uid);
        allow create: if isSignedIn() && (
          (request.resource.data.roomId != null && isRoomAdmin(request.resource.data.roomId))
          || (request.resource.data.roomId == null && isSelf(uid))
          || (request.resource.data.roomId == null && exists(/databases/$(database)/documents/landlordConnections/$(uid))
            && get(/databases/$(database)/documents/landlordConnections/$(uid)).data.landlordUid == request.auth.uid
            && get(/databases/$(database)/documents/landlordConnections/$(uid)).data.status == "approved")
        );
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // roomCodes/{code} — uniqueness index only. Readable so a join-by-code
    // lookup can resolve roomId; never contains financial data.
    // ---------------------------------------------------------------------
    match /roomCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.roomId is string
        && isRoomAdmin(resource.data.roomId);
    }

    // ---------------------------------------------------------------------
    // rooms/{roomId}
    // ---------------------------------------------------------------------
    match /rooms/{roomId} {
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.get("landlordUid", null) is string
        && isApprovedConnection(request.auth.uid, request.resource.data.get("landlordUid", null));
      // Landlord never reads room documents: room/admin/roommate data stays private.
      allow read: if isActiveRoomMember(roomId);
      allow update: if (
        isRoomAdmin(roomId)
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.roomId == resource.data.roomId
        && (
          request.resource.data.get("landlordUid", null) == resource.data.get("landlordUid", null)
          || (request.resource.data.get("landlordUid", null) is string && isApprovedConnection(request.auth.uid, request.resource.data.get("landlordUid", null)))
        )
      );
      allow delete: if isRoomAdmin(roomId);

      match /members/{memberUid} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if (isRoomAdmin(roomId) || isRoomAdminAfter(roomId))
          && request.resource.data.uid == memberUid
          && request.resource.data.role in ["admin", "roommate"]
          && request.resource.data.status in ["active", "inactive"];
        allow update: if isRoomAdmin(roomId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status in ["active", "inactive"];
        allow delete: if isRoomAdmin(roomId); // deleting the entire room removes member records
      }

      match /rentPayments/{paymentId} {
        allow read, create: if isActiveRoomMember(roomId) || isLandlordForRoom(roomId);
        allow update, delete: if isRoomAdmin(roomId);
      }

      match /categories/{categoryId} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if isRoomAdmin(roomId);
        allow update, delete: if isRoomAdmin(roomId);
      }

      match /expenses/{expenseId} {
        allow read: if isActiveRoomMember(roomId);
        allow create, update: if isRoomAdmin(roomId); // roommates are read-only, per spec §21
        allow delete: if isRoomAdmin(roomId); // Room Admin can remove an expense
      }

      match /payments/{paymentId} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if isRoomAdmin(roomId);
        allow update, delete: if isRoomAdmin(roomId);
      }

      match /settlements/{settlementId} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if isRoomAdmin(roomId);
        allow update, delete: if isRoomAdmin(roomId);
      }

      match /notifications/{notifId} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if isRoomAdmin(roomId);
        allow update, delete: if isRoomAdmin(roomId);
      }
    }

    // ---------------------------------------------------------------------
    // joinRequests/{requestId}
    // ---------------------------------------------------------------------
    match /joinRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.roomId is string
        && request.resource.data.applicant is map;
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isRoomAdmin(resource.data.roomId));
      allow update: if isRoomAdmin(resource.data.roomId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.status in ["approved", "rejected"];
      // A roommate may cancel only their own still-pending request.
      // Admin-resolved requests cannot be deleted by the applicant.
      allow delete: if (isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == "pending")
        || (isSignedIn() && isRoomAdmin(resource.data.roomId));
    }

    // ---------------------------------------------------------------------
    // auditLogs/{logId} — append-only, never client-editable or deletable.
    // ---------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isSignedIn() && isRoomAdmin(resource.data.roomId);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Landlord / property collections — scaffolded for Phase 2.
    // ---------------------------------------------------------------------
    match /properties/{propertyId} {
      // Only a signed-in Makan Malik account can create a building/property.
      // The owner UID is always the authenticated Firebase UID.
      allow create: if isSignedIn()
        && myProfile().role == "landlord"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow get: if isSignedIn()
        && myProfile().role == "landlord"
        && resource.data.ownerUid == request.auth.uid;
      allow list: if isSignedIn()
        && myProfile().role == "landlord"
        && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && myProfile().role == "landlord"
        && resource.data.ownerUid == request.auth.uid;

      match /floors/{floorId} {
        allow read, create, update: if isLandlordOwner(propertyId);
        allow delete: if false;
      }
      match /rooms/{roomId} {
        allow read, create, update: if isLandlordOwner(propertyId);
        allow delete: if false;
        match /tenants/{tenantId} {
          allow read, create, update: if isLandlordOwner(propertyId);
          allow delete: if false;
        }
      }
      match /rentPayments/{paymentId} {
        allow read, create: if isLandlordOwner(propertyId);
        allow update, delete: if false;
      }
      match /notices/{noticeId} {
        allow read, create: if isLandlordOwner(propertyId);
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // landlordCodes/{code} — public-to-authenticated lookup index. It never
    // contains private landlord data; it only maps a short code to a landlord UID.
    // ---------------------------------------------------------------------
    match /landlordCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && myProfile().role == "landlord"
        && request.resource.data.landlordUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && myProfile().role == "landlord"
        && resource.data.landlordUid == request.auth.uid;
    }

    match /landlordConnections/{adminUid} {
      allow read: if isSelf(adminUid) || (isSignedIn() && resource.data.landlordUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.adminUid == adminUid
        && request.resource.data.get("landlordUid", null) == request.auth.uid
        && request.resource.data.status == "approved"
        && getAfter(/databases/$(database)/documents/propertyRequests/$(adminUid)).data.status == "approved"
        && getAfter(/databases/$(database)/documents/propertyRequests/$(adminUid)).data.landlordUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.landlordUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.get("landlordUid", null) == resource.data.get("landlordUid", null)
        && request.resource.data.status == "approved"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["buildingId", "updatedAt"]);
      allow delete: if false;
    }

    match /propertyRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestType == "roomAdminConnection"
        && request.resource.data.status == "pending"
        && request.resource.data.get("landlordUid", null) is string
        && request.resource.data.get("connectionCode", null) is string
        && get(/databases/$(database)/documents/landlordCodes/$(request.resource.data.connectionCode)).data.landlordUid == request.resource.data.get("landlordUid", null);
      allow read: if isSignedIn()
        && (resource.data.requestedBy == request.auth.uid || resource.data.landlordUid == request.auth.uid);
      allow update: if isSignedIn() && (
        (resource.data.landlordUid == request.auth.uid
          && request.resource.data.requestedBy == resource.data.requestedBy
          && request.resource.data.get("landlordUid", null) == resource.data.get("landlordUid", null)
          && request.resource.data.status in ["approved", "rejected"])
        || (resource.data.requestedBy == request.auth.uid
          && resource.data.status == "rejected"
          && request.resource.data.requestedBy == resource.data.requestedBy
          && request.resource.data.get("landlordUid", null) == resource.data.get("landlordUid", null)
          && request.resource.data.status == "pending")
      );
      allow delete: if isSignedIn()
        && resource.data.requestedBy == request.auth.uid
        && resource.data.status == "pending";
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
